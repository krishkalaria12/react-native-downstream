{
  "extends": "./tsconfig",
  "compilerOptions": {
    // The component tests mount into a DOM node and read HTMLDivElement.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vitest/globals"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "vitest.config.mts"
  ]
}
