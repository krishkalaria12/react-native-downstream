      "id": "emphasis",
      "description": "Open and closing emphasis across chunk boundaries",
      "source": "emphasis.md",
      "expectedHtml": "emphasis.expected.html",
      "chunks": [
        "hello ",
        "**",
        "wor",
        "ld",
        "**",
        " and _fri",
        "ends_",
        ".\n"
      ],
      "checkpoints": [
        {
          "afterChunk": 3,
          "prefix": "hello **wor",
          "expectedPreview": {
            "visibleText": "hello wor",
            "provisionalStyles": [
              "strong"
            ]
          }
        },
        {
          "afterChunk": 5,
          "prefix": "hello **world**",
          "expectedPreview": {
            "visibleText": "hello world",
            "provisionalStyles": []
          }
        },
        {
          "afterChunk": 6,
          "prefix": "hello **world** and _fri",
          "expectedPreview": {
            "visibleText": "hello world and fri",
            "provisionalStyles": [
              "emphasis"
            ]
          }
        },
        {
          "afterChunk": 8,
          "prefix": "hello **world** and _friends_.\n",
          "expectedPreview": {
            "visibleText": "hello world and friends.",
            "provisionalStyles": []
          }
        }
      ]
    },
