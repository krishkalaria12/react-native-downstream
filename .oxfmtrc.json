{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "quoteProps": "consistent",
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "useTabs": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "lib/",
    "**/build/**",
    "example/ios/**",
    "example/android/**",
    "example/dist/**",
    "src/cpp/md4c/**",
    "src/cpp/wasm/**",
    "src/cpp/glew/**",
    "src/cpp/rapidjson/**",
    "src/cpp/react/**",
    "math/vendor/**",
    "patches/**",
    "tests/fixtures/**",
    "src/cpp/tests/lexer_cases/**",
    "src/cpp/theme/ThemeSlots.h",
    "src/themeSlots.ts",
    "src/android/src/main/java/com/downstream/ThemeSlots.kt"
  ]
}
