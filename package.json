{
  "name": "react-native-downstream",
  "version": "0.1.0",
  "description": "React Native Downstream",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krishkalaria12/react-native-downstream.git"
  },
  "author": "Krish Kalaria <codewithkrish12@gmail.com>",
  "homepage": "https://github.com/krishkalaria12/react-native-downstream#readme",
  "bugs": {
    "url": "https://github.com/krishkalaria12/react-native-downstream/issues"
  },
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "*.podspec",
    "react-native.config.js",
    "!src/ios/build",
    "!src/android/build",
    "!src/android/gradle",
    "!src/android/gradlew",
    "!src/android/gradlew.bat",
    "!src/android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!/tests",
    "!/benchmarks",
    "!**/.*"
  ],
  "scripts": {
    "example": "pnpm --filter react-native-downstream-example",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:native": "node --test src/cpp/tests/engine.test.mjs",
    "test:kotlin": "node tests/android/run.mjs",
    "test:ios:layout": "bash tests/ios/run-native-harness.sh",
    "test:ios:math": "bash tests/ios/run-math-harness.sh",
    "typecheck:android": "node tests/android/typecheck.mjs",
    "bench": "vitest bench --run",
    "bench:native": "node benchmarks/native-highlight.mjs",
    "bench:math": "node benchmarks/native-math.mjs",
    "bench:code-layout": "node benchmarks/code-layout-kotlin.mjs",
    "release": "release-it --only-version"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.12",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "@vitest/coverage-v8": "5.0.2",
    "commitlint": "^19.8.1",
    "del-cli": "^6.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "happy-dom": "20.14.5",
    "jest": "^29.7.0",
    "lefthook": "^2.0.3",
    "prettier": "^2.8.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-builder-bob": "^0.40.18",
    "react-native-enriched-markdown": "0.6.0",
    "react-native-streamdown": "0.2.0",
    "release-it": "^19.0.4",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "packageManager": "pnpm@12.5.1",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ],
    "exclude": "**/{__tests__,__fixtures__,__mocks__,cpp,ios,android,fixtures}/**"
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "create-react-native-library": {
    "type": "library",
    "languages": "js",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it"
    ],
    "version": "0.57.2"
  },
  "codegenConfig": {
    "name": "DownstreamSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.downstream"
    },
    "ios": {
      "componentProvider": {
        "DownstreamMarkdownView": "DownstreamMarkdownView",
        "DownstreamFenceSlot": "RCTView"
      },
      "modulesProvider": {
        "DownstreamSession": "DownstreamSessionProvider"
      }
    }
  }
}
