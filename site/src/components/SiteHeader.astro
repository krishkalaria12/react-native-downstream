---
import Mark from './Mark.astro';

const path = Astro.url.pathname;
const sections = [
  { href: '/docs', label: 'Docs', active: path.startsWith('/docs') },
  { href: '/benchmarks', label: 'Benchmarks', active: path.startsWith('/benchmarks') },
];
---

<header class="sticky top-0 z-50 border-b border-ink/15 bg-paper/90 backdrop-blur-md" transition:animate="none">
  <div class="shell-wide flex h-[68px] items-center gap-1.5 sm:gap-6">
    <a href="/" class="mr-auto flex shrink-0 items-center gap-2" aria-label="Downstream home">
      <Mark size={32} />
      <span class="font-display text-[19px] font-extrabold max-[359px]:sr-only sm:text-[21px] tracking-[-0.045em] [font-variation-settings:'opsz'_32]">Downstream</span>
    </a>

    <nav class="flex items-center gap-1" aria-label="Primary">
      {
        sections.map((section) => (
          <a
            href={section.href}
            class:list={[
              'relative rounded-lg px-2 py-2 text-[14.5px] font-semibold transition-colors sm:px-3 sm:text-[15px]',
              section.active ? 'text-ink' : 'text-ink-soft hover:text-ink',
            ]}
            aria-current={section.active ? 'page' : undefined}
          >
            {section.label}
            {section.active && (
              <span
                class="absolute inset-x-2 -bottom-[15px] h-[3px] rounded-full bg-coral sm:inset-x-3"
                transition:name="nav-indicator"
              />
            )}
          </a>
        ))
      }
    </nav>

    <button
      type="button"
      data-search-open
      class="flex h-10 w-10 shrink-0 items-center justify-center gap-2 rounded-xl border border-ink/20 bg-cream/70 text-[14.5px] md:w-auto md:px-3 text-ink-faint transition-colors hover:border-ink/45 hover:text-ink-soft"
      aria-label="Search the docs"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
      </svg>
      <span class="hidden md:inline">Search</span>
      <kbd class="kbd hidden md:inline-grid">⌘K</kbd>
    </button>

    <a
      href="https://github.com/krishkalaria12/react-native-downstream"
      target="_blank"
      rel="noreferrer"
      class="hidden h-10 w-10 place-items-center rounded-xl text-ink-soft transition-colors hover:bg-ink/5 hover:text-ink sm:grid"
      aria-label="Downstream on GitHub"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.7 5.38-5.27 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
        ></path>
      </svg>
    </a>
  </div>
</header>
