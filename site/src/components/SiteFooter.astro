---
import Link from './Link.astro';
import Mark from './Mark.astro';

const repo = 'https://github.com/krishkalaria12/react-native-downstream';

// Footer links are ordinary full-page navigations; the client router is kept
// for moving around inside the docs and between the main sections.
const columns = [
  {
    label: 'Learn',
    links: [
      { href: '/docs/getting-started', label: 'Getting started' },
      { href: '/docs/streaming', label: 'Streaming' },
      { href: '/docs/api', label: 'API reference' },
      { href: '/benchmarks', label: 'Benchmarks' },
    ],
  },
  {
    label: 'Project',
    links: [
      { href: repo, label: 'GitHub' },
      { href: `${repo}/issues`, label: 'Issues' },
      { href: `${repo}/blob/main/CONTRIBUTING.md`, label: 'Contributing' },
      { href: `${repo}/blob/main/LICENSE`, label: 'MIT license' },
    ],
  },
];
---

<footer class="border-t border-ink/15 bg-paper-deep/60">
  <div class="shell-wide grid gap-10 py-14 md:grid-cols-[1.6fr_1fr_1fr]">
    <div>
      <Link href="/" reload class="inline-flex items-center gap-2.5" aria-label="Downstream home">
        <Mark size={32} />
        <span class="font-display text-[21px] font-extrabold tracking-[-0.045em]">Downstream</span>
      </Link>
      <p class="mt-4 max-w-[38ch] text-[15px] leading-relaxed text-ink-soft">
        Native Markdown for React Native, built for text that arrives one token at a time.
      </p>
    </div>

    {
      columns.map((column) => (
        <div>
          <p class="text-[14px] font-semibold text-ink-faint">{column.label}</p>
          <ul class="mt-3 space-y-2">
            {column.links.map((link) => (
              <li>
                <Link href={link.href} reload class="text-[15px] text-ink-soft transition-colors hover:text-ink">
                  {link.label}
                </Link>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="shell-wide flex flex-col gap-2 border-t border-ink/10 py-6 text-[13.5px] text-ink-faint sm:flex-row sm:justify-between">
    <p>MIT licensed. Requires the React Native New Architecture.</p>
    <p>Benchmarks measured on a OnePlus Nord CE 3, Android 15, 120 Hz.</p>
  </div>
</footer>
