---
type Props = { size?: number };

const { size = 34 } = Astro.props;
---

<span
  class="grid shrink-0 place-items-center text-white"
  style={`width:${size}px;height:${size}px;background:var(--color-blue);border-radius:45% 55% 62% 38%;transform:rotate(-7deg)`}
  aria-hidden="true"
>
  <svg
    width={size * 0.56}
    height={size * 0.56}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M12 4v14" />
    <path d="m6 12 6 6 6-6" />
  </svg>
</span>
