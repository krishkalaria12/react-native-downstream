---
import BaseLayout from './BaseLayout.astro';
import Link from '../components/Link.astro';
import { docGroups, neighbours } from '../data/nav';
import { cleanHeading } from '../data/search';
import { absolute, breadcrumbs, site } from '../data/site';

type Heading = { depth: number; slug: string; text: string };

type Props = {
  title: string;
  description: string;
  slug: string;
  headings?: Heading[];
};

const { title, description, slug, headings = [] } = Astro.props;
const { previous, next } = neighbours(slug);
const group = docGroups.find((item) => item.items.some((link) => link.slug === slug));
const toc = headings
  .filter((heading) => heading.depth === 2 || heading.depth === 3)
  .map((heading) => ({ ...heading, text: cleanHeading(heading.text) }));
const url = absolute(`/docs/${slug}`, Astro.site);
const schema = [
  {
    '@type': 'TechArticle',
    '@id': `${url}#article`,
    headline: title,
    description,
    url,
    inLanguage: 'en',
    articleSection: group?.label,
    author: { '@type': 'Person', name: site.author.name, url: site.author.url },
    about: { '@type': 'SoftwareSourceCode', name: site.packageName, codeRepository: site.repo },
    proficiencyLevel: 'Beginner',
  },
  breadcrumbs(
    [
      { name: 'Home', path: '/' },
      { name: 'Docs', path: '/docs' },
      { name: title, path: `/docs/${slug}` },
    ],
    Astro.site,
  ),
];
const editUrl = `https://github.com/krishkalaria12/react-native-downstream/edit/main/site/src/content/docs/${slug}.md`;

const linkBase =
  'block rounded-lg px-3 py-[7px] text-[15px] leading-snug text-ink-soft transition-colors hover:bg-ink/[0.05] hover:text-ink aria-[current=page]:bg-yellow-soft aria-[current=page]:font-semibold aria-[current=page]:text-ink';
---

<BaseLayout title={`${title} | Downstream docs`} description={description} type="article" schema={schema}>
  <div class="shell-wide grid gap-x-12 lg:grid-cols-[232px_minmax(0,1fr)] xl:grid-cols-[232px_minmax(0,1fr)_212px]">
    <!-- Persisted across docs navigations so its scroll position and state stay put. -->
    <aside
      class="hidden lg:sticky lg:top-[68px] lg:block lg:h-[calc(100vh-68px)] lg:self-start lg:overflow-y-auto lg:py-10 lg:pr-2"
      transition:persist="docs-sidebar"
    >
      <nav aria-label="Documentation" data-docs-nav>
        <a href="/docs" class={linkBase} data-path="/docs">Overview</a>
        {
          docGroups.map((item) => (
            <div class="mt-7">
              <p class="px-3 text-[13px] font-semibold text-ink-faint">{item.label}</p>
              <ul class="mt-1.5 space-y-px">
                {item.items.map((link) => (
                  <li>
                    <a
                      href={`/docs/${link.slug}`}
                      class={linkBase}
                      data-path={`/docs/${link.slug}`}
                      aria-current={link.slug === slug ? 'page' : undefined}
                    >
                      {link.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <div class="mt-8 border-t border-ink/10 pt-5">
          <a href="/benchmarks" class="group block rounded-xl px-3 py-2">
            <span class="block text-[15px] font-semibold text-ink group-hover:text-blue">Benchmarks</span>
            <span class="mt-0.5 block text-[13.5px] leading-snug text-ink-faint">Six libraries measured on a real phone</span>
          </a>
        </div>
      </nav>
    </aside>

    <article class="min-w-0 pt-8 pb-24 lg:pt-12" transition:name="doc-article">
      <details class="group mb-8 rounded-xl border-[1.5px] border-ink bg-cream lg:hidden" data-docs-menu>
        <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-[15px] font-semibold">
          <span>{group?.label ?? 'Docs'}: <span class="font-normal text-ink-soft">{title}</span></span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" class="transition-transform duration-300 group-open:rotate-180" aria-hidden="true">
            <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </summary>
        <div class="border-t border-rule px-2 pt-2 pb-3">
          <a href="/docs" class={linkBase}>Overview</a>
          {
            docGroups.map((item) => (
              <div class="mt-4">
                <p class="px-3 text-[13px] font-semibold text-ink-faint">{item.label}</p>
                {item.items.map((link) => (
                  <a href={`/docs/${link.slug}`} class={linkBase} aria-current={link.slug === slug ? 'page' : undefined}>
                    {link.title}
                  </a>
                ))}
              </div>
            ))
          }
        </div>
      </details>

      <div class="max-w-[720px]">
        <p class="text-[14px] font-semibold text-coral">{group?.label}</p>
        <h1
          class="display mt-2 text-[clamp(40px,5vw,60px)]"
          transition:name={`doc-title-${slug}`}
        >
          {title}
        </h1>
        <p class="lead mt-4 max-w-[60ch]">{description}</p>

        <div class="prose-docs mt-10 border-t-[1.5px] border-ink pt-10">
          <slot />
        </div>

        <div class="mt-14 flex flex-wrap items-center justify-between gap-3 text-[14.5px] text-ink-faint">
          <Link href={editUrl} class="text-link font-medium text-ink-soft">Edit this page on GitHub</Link>
          <a href="#main" class="hover:text-ink">Back to top</a>
        </div>

        <nav class="mt-6 grid gap-3 sm:grid-cols-2" aria-label="Previous and next page">
          {
            previous ? (
              <a href={`/docs/${previous.slug}`} class="group rounded-2xl border-[1.5px] border-ink/20 px-5 py-4 transition-colors hover:border-ink hover:bg-cream">
                <span class="text-[13.5px] text-ink-faint">Previous</span>
                <span class="mt-0.5 block font-display text-[19px] font-bold tracking-[-0.025em]">{previous.title}</span>
              </a>
            ) : (
              <span class="hidden sm:block" />
            )
          }
          {
            next ? (
              <a href={`/docs/${next.slug}`} class="group rounded-2xl border-[1.5px] border-ink/20 px-5 py-4 text-right transition-colors hover:border-ink hover:bg-cream">
                <span class="text-[13.5px] text-ink-faint">Next</span>
                <span class="mt-0.5 block font-display text-[19px] font-bold tracking-[-0.025em]">{next.title}</span>
              </a>
            ) : (
              <a href="/benchmarks" class="rounded-2xl border-[1.5px] border-ink bg-yellow px-5 py-4 text-right">
                <span class="text-[13.5px] text-ink-soft">Next</span>
                <span class="mt-0.5 block font-display text-[19px] font-bold tracking-[-0.025em]">See the benchmarks</span>
              </a>
            )
          }
        </nav>
      </div>
    </article>

    {
      toc.length > 0 && (
        <aside class="hidden xl:block">
          <div class="sticky top-[68px] max-h-[calc(100vh-68px)] overflow-y-auto py-12">
            <p class="text-[13px] font-semibold text-ink-faint">On this page</p>
            <ul class="mt-3 border-l border-ink/15" data-toc>
              {toc.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    data-toc-link={heading.slug}
                    class:list={[
                      '-ml-px block border-l-2 border-transparent py-[5px] text-[14px] leading-snug text-ink-faint transition-colors hover:text-ink data-[active]:border-coral data-[active]:text-ink',
                      heading.depth === 2 ? 'pl-4' : 'pl-7 text-[13.5px]',
                    ]}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      )
    }
  </div>
</BaseLayout>

<script>
  let observer: IntersectionObserver | undefined;

  const syncSidebar = () => {
    // The sidebar is persisted, so its server-rendered aria-current is stale
    // after a client-side navigation; recompute it from the URL.
    const path = location.pathname.replace(/\/$/, '') || '/';
    document.querySelectorAll<HTMLAnchorElement>('[data-docs-nav] a[data-path]').forEach((link) => {
      if (link.dataset.path === path) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  };

  const watchHeadings = () => {
    observer?.disconnect();
    const links = new Map<string, HTMLElement>();
    document.querySelectorAll<HTMLElement>('[data-toc-link]').forEach((link) => links.set(link.dataset.tocLink!, link));
    if (links.size === 0) return;

    const visible = new Set<string>();
    const headings = [...document.querySelectorAll<HTMLElement>('.prose-docs :is(h2, h3)[id]')].filter((h) => links.has(h.id));
    const mark = () => {
      const current = headings.find((h) => visible.has(h.id)) ?? headings.filter((h) => h.getBoundingClientRect().top < 120).at(-1);
      links.forEach((link, id) => link.toggleAttribute('data-active', id === current?.id));
    };
    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }
        mark();
      },
      { rootMargin: '-70px 0px -60% 0px' },
    );
    headings.forEach((heading) => observer!.observe(heading));
    mark();
  };

  document.addEventListener('astro:page-load', () => {
    syncSidebar();
    watchHeadings();
  });
  document.addEventListener('astro:before-swap', () => observer?.disconnect());
</script>
