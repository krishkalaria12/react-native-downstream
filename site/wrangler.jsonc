{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "react-native-downstream-site",
  "compatibility_date": "2026-10-30",
  // The site is fully prerendered, so it deploys as static assets with no Worker code.
  "assets": {
    "directory": "./dist",
    // Astro builds `docs/streaming.html` and links to `/docs/streaming`; serve that
    // address and redirect `/docs/streaming/` and `/docs/streaming.html` to it.
    "html_handling": "drop-trailing-slash",
    // Serve dist/404.html with a 404 status for unknown paths.
    "not_found_handling": "404-page",
  },
  // To serve the site on your own domain (the zone must be on this Cloudflare account):
  // "routes": [{ "pattern": "downstream.krishkalaria.dev", "custom_domain": true }],
}
